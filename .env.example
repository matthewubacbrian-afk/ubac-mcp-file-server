# Copy to .env and fill in. Never commit .env.
# Tokens must be at least 16 characters. Generate one with:  openssl rand -hex 24
MCP_TOKEN=change-me-builder-token
# Optional read-only role. Delete the line to disable it.
MCP_TOKEN_REVIEWER=change-me-reviewer-token
PORT=3000
WORKSPACE_ROOT=./workspace
LOG_DIR=./logs
# Your free static ngrok domain (ngrok dashboard > Domains), e.g. my-name.ngrok-free.app
NGROK_DOMAIN=your-domain.ngrok-free.app
